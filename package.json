{
  "name": "chw-timesheet",
  "version": "0.0.0",
  "private": true,
  "description": "Offline phone app for Community Health Workers to log time and generate invoices.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve-dist.mjs 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:sources": "node scripts/check-funding-sources.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:size": "node scripts/check-size.mjs",
    "licenses:update": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "check": "node scripts/check-all.mjs"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
